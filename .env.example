# Required — put these in Railway Variables (or local .env)

# Solana deposit wallet that receives USDC (base58 public key)
DEPOSIT_WALLET=YourSolanaWalletAddressHere

# Helius API key from https://dashboard.helius.dev
HELIUS_API_KEY=your_helius_api_key

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# --- Optional ---

# Gets a "+1" DM whenever someone presses /start (default: 6473954258)
# ADMIN_TELEGRAM_ID=6473954258


# HTTP port (Railway sets PORT automatically)
# PORT=3000

# Override auto webhook auth (otherwise a stable secret is derived for you)
# WEBHOOK_AUTH_SECRET=change_me_to_a_long_random_string

# Disable auto Helius webhook create/update on boot (default: enabled)
# AUTO_REGISTER_WEBHOOK=false

# Local/ngrok only — Railway uses RAILWAY_PUBLIC_DOMAIN automatically
# PUBLIC_URL=https://xxxx.ngrok-free.app

# HELIUS_NETWORK=mainnet-beta
# USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Volume path for subscriber storage (default uses RAILWAY_VOLUME_MOUNT_PATH if set)
# DATA_DIR=/data
